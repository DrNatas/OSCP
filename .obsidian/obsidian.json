{
  "theme": "obsidian",
  "enabledCssSnippets": [],
  "spellcheck": true,
  "spellcheckDictionary": [
    "OSCP",
    "LDAP",
    "SMB",
    "RPC",
    "HTTPs",
    "Kerbrute",
    "Kerberos",
    "BloodHound",
    "PowerView",
    "Metasploit",
    "Burp",
    "Nmap",
    "ffuf",
    "Nuclei",
    "PayloadsAllTheThings"
  ],
  "useTab": true,
  "useMarkdownLinks": true,
  "newFileLocation": "folder",
  "newFileFolderPath": ".",
  "showLineNumber": true,
  "lineLength": 0,
  "strictLineBreaks": false,
  "showFrontmatter": false,
  "showIndentGuide": true,
  "foldIndent": true,
  "foldHeading": true,
  "folderColors": {
    "Enumeration": "#2E7D32",
    "Exploitation": "#E53935",
    "Post-Exploitation": "#F57C00",
    "Tools-Reference": "#1976D2",
    "Writeup-Templates": "#7B1FA2",
    "Payloads": "#C2185B"
  },
  "alwaysUpdateLinks": true,
  "showUnsupportedFiles": false,
  "showUnknownFileTypes": false,
  "attachmentFolderPath": "./",
  "newLinkFormat": "relative"
}
